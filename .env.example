# ================================
# 🔑 CREDENCIAIS BINANCE - PRODUÇÃO
# ================================
# Obtenha em: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=sua_chave_de_producao_aqui
BINANCE_SECRET_KEY=seu_secret_de_producao_aqui

# ================================
# 🧪 CREDENCIAIS BINANCE - TESTNET
# ================================
# Obtenha em: https://testnet.binancefuture.com/
# Passos:
# 1. Acesse https://testnet.binancefuture.com/
# 2. Faça login com GitHub ou Google
# 3. Vá em "API Key" no menu superior
# 4. Clique em "Create API Key"
# 5. Copie a API Key e o Secret Key
BINANCE_TESTNET_API_KEY=sua_chave_da_testnet_aqui
BINANCE_TESTNET_SECRET_KEY=seu_secret_da_testnet_aqui

# ================================
# 📱 TELEGRAM BOT
# ================================
TELEGRAM_BOT_TOKEN_BOT_TRADE=seu_token_telegram_aqui

# ================================
# 🤖 APIs DE IA
# ================================
OPENAI_API_KEY=sua_chave_openai_aqui
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
